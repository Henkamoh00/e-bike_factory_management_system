# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres.[project-ref]:[your-password]@[aws-region].pooler.supabase.com:6543/postgres

# Redis Cache & Rate Limiting (Upstash Redis)
REDIS_URL=rediss://default:[your-redis-password]@[your-upstash-host].upstash.io:6379

# Authentication & Security
# Generate a secret key via: openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_key_here

# 
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookie & Session Settings
# Set to 'true' in production with HTTPS, 'false' for local development
COOKIE_SECURE=false

# Leave empty for localhost, or set to your domain in production (e.g., .yourdomain.com)
COOKIE_DOMAIN=

# Trusted Proxy IPs for Rate Limiting / Real IP extraction
# IMPORTANT: In production, set this to your reverse proxy/load balancer IP (e.g., Nginx or hosting service).
# Without it, rate limiting falls back to direct connection IP only (safe, but accurate only if no proxy is used).
# Comma-separated list (e.g., 127.0.0.1,10.0.0.1) or '*' to trust all proxies. Leave empty if no proxy.
TRUSTED_PROXY_IPS=



# متغير البيئة INVOICE_VERIFICATION_SECRET_KEY غير مُعرَّف.
# يجب تعيين قيمة عشوائية قوية وسرية لهذا المتغير قبل تشغيل السيرفر
# (مثال للتوليد: python -c "import secrets; print(secrets.token_hex(32))").
# هذا المفتاح مستقل تمامًا عن JWT_SECRET_KEY ويُستخدم فقط لتوقيع
# روابط التحقق من صحة الفواتير المطبوعة.
INVOICE_VERIFICATION_SECRET_KEY=<python -c "import secrets; print(secrets.token_hex(32))">

# متغير البيئة INVOICE_VERIFY_BASE_URL غير مُعرَّف.
# يجب تعيين رابط السيرفر العام الذي سيُستخدم داخل رمز QR على الفواتير
# (مثال: https://api.yourdomain.com).
INVOICE_VERIFY_BASE_URL=https://api.yourdomain.com

# اختياري، له قيمة افتراضية
INVOICE_VERIFY_PATH_PREFIX=/dq7f-doc-chk-2x9k 

# Company details printed on invoice PDFs
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=Your City