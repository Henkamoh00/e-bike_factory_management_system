# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres.[project-ref]:[your-password]@[aws-region].pooler.supabase.com:6543/postgres

# Redis Cache & Rate Limiting (Upstash Redis)
REDIS_URL=rediss://default:[your-redis-password]@[your-upstash-host].upstash.io:6379

# Authentication & Security
# Generate a secret key via: openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_key_here

# Cookie & Session Settings
# Set to 'true' in production with HTTPS, 'false' for local development
COOKIE_SECURE=false

# Leave empty for localhost, or set to your domain in production (e.g., .yourdomain.com)
COOKIE_DOMAIN=