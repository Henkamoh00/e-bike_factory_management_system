[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    env,
    build,
    dist,
    *.egg-info,
    test_suite/test_db.sqlite3,
    migrations
extend-ignore =
    E501,
    W503,
    E203
per-file-ignores =
    __init__.py:F401
    test_suite/conftest.py:E402
max-complexity = 20


# Strict spacing rules active (removed E712, E302, E305, E221, E261, W292, W293)